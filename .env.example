# ============================================
# AWS Configuration
# ============================================
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=us-east-1

# Optional: For CloudFront Analytics
CLOUDFRONT_LOG_BUCKET=your-cloudfront-logs-bucket-name

# ============================================
# Database Configuration (MySQL)
# ============================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=cloudwatch_sentinel

# ============================================
# AI Configuration (OpenAI)
# ============================================
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

# ============================================
# Email Notification Configuration
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_FROM=your_email@gmail.com
ALERT_EMAIL_TO=recipient@example.com

# ============================================
# Feature Toggles (true/false)
# ============================================
ENABLE_SECURITY_SCAN=true
ENABLE_PERFORMANCE_SCAN=true
ENABLE_HEALTH_CHECK=true
ENABLE_COMPLIANCE_CHECK=true
ENABLE_QUOTA_CHECK=true
ENABLE_BACKUP_CHECK=true

# ============================================
# Analysis Settings
# ============================================
ANALYSIS_TIMEFRAME_MINUTES=60
PERFORMANCE_ANALYSIS_HOURS=24
REQUIRED_TAGS=Environment,Owner,Project,CostCenter
